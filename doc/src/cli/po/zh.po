#. type: Title ===
#: cli.adoc:120
#, no-wrap
msgid "Footprint upgrade"
msgstr "封装升级"

#. type: Plain text
#: cli.adoc:126
msgid ""
"The `fp upgrade` command converts the the specified footprint library from a legacy KiCad footprint format or a non-KiCad footprint format to the native format for the current version of KiCad. If the input library is already in the current file format, no "
"action is taken."
msgstr "`fp upgrade` 命令将指定的封装库从旧的 KiCad 封装格式或非 KiCad 封装格式转换为当前版本 KiCad 的原生格式。如果输入库已经采用当前文件格式，则不会采取任何操作。"

#. type: Plain text
#: cli.adoc:128
msgid "Supported input footprint formats are:"
msgstr "支持的输入封装格式为："

#. type: Plain text
#: cli.adoc:130
msgid "KiCad footprint library (`.pretty` folder with `.kicad_mod` files)"
msgstr "KiCad 封装库（包含 `.kicad_mod` 文件的 `.pretty` 文件夹）"

#. type: Plain text
#: cli.adoc:131
msgid "KiCad (pre-5.0) footprint library (`.mod`, `.emp`)"
msgstr "KiCad（5.0 之前版本）封装库（`.mod`、`.emp`）"

#. type: Plain text
#: cli.adoc:132
msgid "Altium footprint library (`.PcbLib`)"
msgstr "Altium 封装库 (`.PcbLib`)"

#. type: Plain text
#: cli.adoc:133 cli.adoc:2079
msgid "Altium integrated library (`.IntLib`)"
msgstr "Altium 集成库 (`.IntLib`)"

#. type: Plain text
#: cli.adoc:134
msgid "CADSTAR PCB archive (`.cpa`)"
msgstr "CADSTAR PCB 存档文件 (`.cpa`)"

#. type: Plain text
#: cli.adoc:135 cli.adoc:2081
msgid "EAGLE XML library (`.lbr`)"
msgstr "EAGLE XML 库 (`.lbr`)"

#. type: Plain text
#: cli.adoc:136 cli.adoc:2082
msgid "EasyEDA (JLCEDA) Std file (`.json`)"
msgstr "EasyEDA (JLCEDA) 标准版文件 (`.json`)"

#. type: Plain text
#: cli.adoc:137 cli.adoc:2083
msgid "EasyEDA (JLCEDA) Pro file (`.elibz`, `.epro`, `.zip`)"
msgstr "EasyEDA (JLCEDA) 专业版文件 (`.elibz`, `.epro`, `.zip`)"

#. type: Plain text
#: cli.adoc:138
msgid "GEDA/PCB library (folder with `.fp` files)"
msgstr "GEDA/PCB 库（包含 `.fp` 文件的文件夹）"

#. type: Plain text
#: cli.adoc:140
msgid "Usage: `kicad-cli fp upgrade [--help] [--output OUTPUT_DIR] [--force] INPUT_DIR`"
msgstr ""

#. type: Table
#: cli.adoc:148
#, no-wrap
msgid ""
"Footprint library directory to upgrade. For KiCad format footprint\n"
"      libraries, this is the `.pretty` directory, not a `.kicad_mod` file."
msgstr "要升级的封装库目录。对于 KiCad 格式的封装库，这是 `.pretty` 目录，而不是 `.kicad_mod` 文件。"

#. type: Table
