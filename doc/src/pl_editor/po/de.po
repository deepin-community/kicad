#: src/pl_editor/pl_editor.adoc:164
#, no-wrap
msgid "Repeat option"
msgstr "Wiederholungsoption"

#. type: Plain text
#: src/pl_editor/pl_editor.adoc:167
msgid "Items can be repeated:"
msgstr "Elemente können wiederholt werden:"

#. type: Plain text
#: src/pl_editor/pl_editor.adoc:169
msgid "This is useful to create grid and grid labels."
msgstr "Dies ist nützlich, um Raster und Rasterbeschriftungen zu erstellen."

