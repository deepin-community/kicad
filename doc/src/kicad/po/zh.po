#: kicad.adoc:118
#, no-wrap
msgid "`*.kicad_dru`"
msgstr ""

#. type: Table
#: kicad.adoc:119
#, no-wrap
msgid "Design rules file, containing custom design rules for a certain `.kicad_pcb` file."
msgstr "设计规则文件，包含针对特定 `.kicad_pcb` 文件的自定义设计规则。"

#. type: Table
#: kicad.adoc:120
#, no-wrap
msgid "`*.brd`"
msgstr ""

